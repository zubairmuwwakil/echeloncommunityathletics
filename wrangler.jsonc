// Cloudflare Workers config: the built site in ./dist, plus worker/index.js for /api/*.
// Deploy from an account Echelon controls (not a personal or Zemi account).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echelon-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "echeloncommunity.ca", "custom_domain": true }],
  "vars": {
    "SITE_ORIGIN": "https://echeloncommunity.ca"
  }
  // Set GOOGLE_SCRIPT_URL and INQUIRY_SIGNING_KEY as Worker secrets; see README, "Forms".
}
