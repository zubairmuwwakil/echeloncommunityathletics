---
import Layout from "../layouts/Layout.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { site } from "../data/site";

const ways = [
  {
    id: "play-fund",
    title: "Discuss access to play",
    body: "We're exploring ways to help more people take part in recreational sport. Contact us if you would like to support a future access initiative.",
    cta: "Ask about supporting access",
    type: "Something else",
  },
  {
    id: "sponsors",
    title: "Sponsor a program",
    body: "Put your business behind a season, a location or an event. Your name on the program, the court and our site.",
    cta: "Become a sponsor",
    type: "Sponsor",
  },
  {
    id: "funders",
    title: "Fund our growth",
    body: "Foundations, governments and corporate funders: help us open new sites and start youth and 55+ programs. We'll report on what your funding achieves.",
    cta: "Start a funding conversation",
    type: "Foundation or grant funder",
  },
  {
    id: "volunteer",
    title: "Coach or volunteer",
    body: "Coaches, organizers and people with skills in finance, fundraising or governance. Time is a gift too.",
    cta: "Get involved",
    type: "Something else",
  },
];

const measures = [
  ["People reached", "How many people play, and how many come back for a second season."],
  ["Who we're reaching", "Age groups, first-time players, and how many spots the Play Fund covered."],
  ["Where we play", "The communities and venues we serve, and new ones we open."],
  ["Where the money goes", "Program fees, sponsorship and grants in; venues, coaching, equipment and subsidies out."],
];
---
<Layout title="Support us" description="Give to the Play Fund, sponsor a program or fund Echelon's growth. Help make sport and recreation open to everyone in Canada.">
  <section class="page-head">
    <div class="wrap">
      <p class="kicker">Support us</p>
      <h1 class="display mt">Help more people play.</h1>
      <p class="lede">The hardest part of sport is often getting in the door. We welcome conversations about sponsorship, volunteering and funding that could help more people participate.</p>
    </div>
  </section>

  <section class="wrap">
    <div class="trust partner-grid ways">
      {ways.map((w) => (
        <div id={w.id}>
          <h2 class="h3">{w.title}</h2>
          <p>{w.body}</p>
          <a class="more mt-sm" href={`#start`} data-partner-type={w.type}>{w.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="section reveal">
    <div class="wrap split">
      <div>
        <p class="kicker">Accountability</p>
        <h2 class="h2">You'll see what your support does.</h2>
        <p class="lede mt">We intend to track participation, programs and funding as Echelon grows. We'll share verified results when reliable reporting is available.</p>
      </div>
      <dl class="ledger">
        {measures.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section-tight reveal">
    <div class="wrap">
      <div class="note-card">
        <h3>Good to know before you give</h3>
        <p>{site.legalName} is a federally incorporated not-for-profit (no. {site.corporationNumber}), not a registered charity. We can't issue charitable tax receipts. Sponsorship arrangements can be discussed separately. Ask a qualified tax professional for advice on the treatment of any payment.</p>
      </div>
    </div>
  </section>

  <section class="section reveal" id="start">
    <div class="wrap split">
      <div>
        <p class="kicker">Start here</p>
        <h2 class="h2">Let's talk.</h2>
        <p class="lede mt">Tell us how you'd like to help. We'll reply personally within a few business days.</p>
      </div>
      <div class="panel">
        <InquiryForm kind="partner" id="support" partnerType="Something else" />
      </div>
    </div>
  </section>
</Layout>
