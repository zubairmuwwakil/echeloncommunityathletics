---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const ledger: { label: string; value: string; verify?: string }[] = [
  { label: "Legal name", value: site.legalName },
  { label: "Incorporated", value: `${site.incorporated}, under the Canada Not-for-profit Corporations Act` },
  { label: "Corporation no.", value: site.corporationNumber },
  { label: "Tax status", value: "Not-for-profit. Not a registered charity, so we can't issue charitable tax receipts." },
  { label: "Programs today", value: site.region },
  { label: "Registration", value: "PB Social, a separate company's software we use for sign-ups and payments" },
];
---
<Layout title="About" description="Echelon Community Athletics Inc. is a federally incorporated not-for-profit for sport and recreation in Durham Region, Ontario.">
  <section class="page-head">
    <div class="wrap">
      <h1 class="display">Sport is how neighbours meet.</h1>
      <p class="lede">Echelon started with a simple idea: if playing is easy to start, affordable and close to home, more people will play, and keep playing together. We began in Durham Region. We're building Echelon to reach communities across Canada.</p>
    </div>
  </section>

  <section class="section-tight reveal">
    <div class="wrap split">
      <div>
        <p class="kicker">Our mission</p>
        <h2 class="h2">Healthier, more connected communities.</h2>
      </div>
      <div>
        <p class="lede">{site.mission}</p>
        <p class="muted mt">We started with pickleball because it's one of the easiest sports to pick up and one of the most social to keep playing. Next come programs for kids and teens, adults and older adults, chosen by what our community asks for.</p>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="wrap split">
      <div>
        <p class="kicker">From our founder</p>
        <h2 class="h2">Why I started Echelon.</h2>
      </div>
      <div class="founder">
        <h3>Zubair Muwwakil · Founder</h3>
        <p>Echelon Community Athletics was founded to create more welcoming and organized ways to participate in recreational sport. The nonprofit begins with community pickleball programs in Durham Region and is exploring more ways to support different ages and abilities.</p>
        <p class="mt">Zubair also builds software products. His <a href="https://zubairmuwwakil.com/">engineering portfolio</a> describes that work separately from Echelon's nonprofit programs.</p>
      </div>
    </div>
  </section>

  <section class="section-tight reveal">
    <div class="wrap">
      <div class="vision">
        <p class="kicker">Where we're going</p>
        <p class="vision-line">{site.vision}</p>
      </div>
    </div>
  </section>

  <section class="section-tight reveal">
    <div class="wrap">
      <div class="trust">
        <div>
          <h3>Welcoming by design</h3>
          <p>Every program has a way in for beginners. Structure makes the first night easy.</p>
        </div>
        <div>
          <h3>Coaching, not just court time</h3>
          <p>Instruction and real games together, so skills stick and people come back.</p>
        </div>
        <div>
          <h3>Neighbours, not strangers</h3>
          <p>Small groups and the same faces each week turn a program into a community.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="wrap split">
      <div>
        <p class="kicker">The facts</p>
        <h2 class="h2">Run in the open.</h2>
        <p class="lede mt">Echelon has no owners or shareholders. Program revenue pays for programs. If Echelon ever winds down, our articles send what's left to qualified community organizations, never to individuals.</p>
      </div>
      <dl class="ledger">
        {ledger.map((r) => (
          <div data-verify={r.verify}><dt>{r.label}</dt><dd>{r.value}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section-tight reveal">
    <div class="wrap split">
      <div class="note-card">
        <h3>Separate organizations, clear roles</h3>
        <p>Echelon Community Athletics Inc. is an independent nonprofit, not a subsidiary of <a href="https://zemiechelon.com/about/">Zemi Echelon</a>. Our founder also works on software, including <a href="https://www.pbsocial.ca/">PB Social</a>, which provides registration technology. Each organization has a separate purpose and its own responsibilities.</p>
      </div>
      <div class="note-card">
        <h3>Get involved</h3>
        <p>We're looking for coaches, volunteers and people with experience in community sport, finance or nonprofit governance. <a href="/contact/">Get in touch</a>.</p>
      </div>
    </div>
  </section>
</Layout>
