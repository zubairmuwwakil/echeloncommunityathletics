---
import Layout from "../../layouts/Layout.astro";
import Glyph from "../../components/Glyph.astro";
import { programs } from "../../data/site";
import { pickleballLocalDate, pickleballSeries } from "../../data/pickleball-series";

const p = programs.find((x) => x.id === "pickleball-learn")!;
const today = pickleballLocalDate();
const currentSeries = pickleballSeries.filter((series) => series.endsOn >= today);
const pastSeries = pickleballSeries.filter((series) => series.endsOn < today);
const faqs: { q: string; a: string; verify?: string }[] = [
  {
    q: "I've never played. Is this for me?",
    a: "Yes. That's who it's designed for. The first hour covers the basics step by step, and the games afterwards are grouped so everyone gets good rallies.",
  },
  {
    q: "What should I bring?",
    a: "Comfortable clothes, clean indoor court shoes and a water bottle. If you own a paddle, bring it.",
    verify: "Confirm whether loaner paddles and balls are provided, and add that here.",
  },
  {
    q: "Can I sign up with a friend or partner?",
    a: "Of course. Each person registers separately, and you're welcome to play together on the night.",
  },
  {
    q: "What if I have to miss a week?",
    a: "Ask the organizer about missed sessions and the refund policy before registering. If you have an existing PB Social registration, use its organizer contact option.",
    verify: "State the actual refund and missed-session policy for the current season.",
  },
];
---
<Layout title="Beginner pickleball in Durham" description="Learn-to-play pickleball in Durham Region, Ontario: beginner-friendly coaching, recreational games and ways to get involved.">
  <section class="page-head">
    <div class="wrap">
      <div class="detail-hero tone-pickleball">
        <Glyph line="pickleball" />
        <span class="status open">Program information</span>
        <h1 class="display mt">{p.title}</h1>
        <p class="lede">{p.summary}</p>
        <div class="feature-actions">
          <a class="btn btn-primary" href="#current-programs">See dates and venues</a>
          <button class="more" type="button" data-interest="pickleball-learn">Join the interest list</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" id="current-programs">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Current pickleball programs</h2>
        <p class="lede">Organized by Echelon Community Athletics. Learn-to-play sessions are led by Zubair Muwwakil, a Pickleball Canada–certified coach. Registration and payment are handled through PB Social.</p>
      </div>
      <div class="series-grid">
        {currentSeries.map((series) => (
          <article class="panel" data-series-end={series.endsOn}>
            <h3 class="h3">{series.name}</h3>
            <p>{series.venue}</p>
            <p>{series.schedule}</p>
            <p data-series-registration>{series.fee}</p>
            <p class="mt" data-series-registration><a class="more" href={series.url}>{series.action}</a></p>
          </article>
        ))}
        <article class="panel">
          <h3 class="h3">Courtice beginner and intermediate leagues</h3>
          <p>Good Shepherd Elementary School, Courtice</p>
          <p>Thursday sessions are planned for January 2027. Ask us about the schedule before booking.</p>
          <p class="mt"><button class="more" type="button" data-interest="pickleball-learn">Get Courtice updates</button></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight" id="recent-programs">
    <div class="wrap">
      <div class="section-head"><h2 class="h2">Recent pickleball sessions</h2></div>
      <div class="series-grid" data-recent-series>
        <article class="panel">
          <h3 class="h3">Beginner pickleball in Port Perry</h3>
          <p>November 16, 2026 · Port Perry High School</p>
          <p>Week three of our Monday learn-to-play series brought new and returning players together for coached practice and match play. Players had time to work on their strokes and then use them in recreational doubles games.</p>
        </article>
        {pastSeries.map((series) => (
          <article class="panel">
            <h3 class="h3">{series.name}</h3>
            <p>{series.venue}</p>
            <p>{series.schedule}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight reveal">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Each session</p>
        <h2 class="h2">Two hours. One for learning, one for playing.</h2>
      </div>
      <div class="agenda">
        <div>
          <p class="time">Hour one</p>
          <h3>Coaching</h3>
          <p>Coaching covers skills one step at a time: the serve, the return, the soft game at the net, and where to stand.</p>
        </div>
        <div>
          <p class="time">Hour two</p>
          <h3>Match play</h3>
          <p>Put it straight into real games with people at your level. Same group each week, so it starts to feel like a club.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight reveal" id="details">
    <div class="wrap split">
      <div>
        <p class="kicker">The details</p>
        <h2 class="h2">Know before you go.</h2>
        <p class="lede mt">Each listing above shows the program schedule and venue. PB Social shows current availability and final prices. For help with a booking or a refund, <a href="/contact/">contact Echelon</a>.</p>
      </div>
      <dl class="facts">
        {p.facts.map((f) => (
          <div data-verify={f.verify}><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
        <div class="wide" data-verify={p.verify}><dt>Where</dt><dd>{p.where.join(", ")}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section reveal">
    <div class="wrap split">
      <div>
        <p class="kicker">Start with confidence</p>
        <h2 class="h2">Your first pickleball session.</h2>
        <p class="lede">You do not need a partner or previous experience. Learn the fundamentals, then practise them with other recreational players.</p>
      </div>
      <div class="faq">
        <h3>What you will practise</h3>
        <p>Start with an underhand serve, a return and the two-bounce rule. Learn how to move with a doubles partner and how to play near the non-volley zone. Focus on keeping the ball in play before trying to hit harder.</p>
        <h3>Before you arrive</h3>
        <p>Ask about equipment availability, accessibility needs and the exact entrance to the gym. Bring clean indoor court shoes and water. Allow time to warm up and take breaks when needed.</p>
        <h3>Find a group close to home</h3>
        <p>Interested in Courtice, Port Perry, Whitby, Oshawa, Ajax or Bowmanville? Tell us your preferred town, skill level and schedule. We use inquiries to plan programs and confirm available facilities before announcing sessions.</p>
        <p class="mt"><a class="more" href="/contact/">Ask about a local beginner program</a></p>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="wrap split">
      <div>
        <p class="kicker">Questions</p>
        <h2 class="h2">Good to know.</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p data-verify={f.verify}>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight reveal">
    <div class="wrap">
      <div class="band">
        <h2 class="h2">Ready for your first game?</h2>
        <p class="lede">Choose your town on the interest form. We’ll let you know when we have new pickleball dates there.</p>
        <div class="feature-actions">
          <button class="btn btn-quiet" type="button" data-interest="pickleball-learn">Get pickleball updates</button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .series-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; }
  .series-grid .panel p + p { margin-top: 6px; }
</style>

<script>
  import { pickleballLocalDate } from "../../data/pickleball-series";

  const recent = document.querySelector("[data-recent-series]");
  const today = pickleballLocalDate();
  document.querySelectorAll<HTMLElement>("[data-series-end]").forEach((article) => {
    if (recent && article.dataset.seriesEnd! < today) {
      article.querySelectorAll("[data-series-registration]").forEach((item) => item.remove());
      recent.append(article);
    }
  });
</script>
