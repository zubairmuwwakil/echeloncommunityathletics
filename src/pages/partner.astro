---
import Layout from "../layouts/Layout.astro";
import InquiryForm from "../components/InquiryForm.astro";

const audiences = [
  {
    id: "schools",
    title: "Schools and municipalities",
    body: "We are exploring partnerships for school and municipal sport programs. We can discuss potential after-school activities, camps and community recreation based on local capacity.",
    points: ["Programs for every age group", "Registration and payments handled", "Insurance and permit needs confirmed for each program"],
    verify: "Only claim insurance and permits once they are in Echelon's own name.",
  },
  {
    id: "residences",
    title: "Seniors' residences and community centres",
    body: "We are exploring daytime recreational activities for older adults and would welcome conversations with residences and community centres.",
    points: ["Weekly or monthly sessions", "Pace adapted to the group", "Equipment brought to you"],
    verify: "Confirm Echelon can supply equipment for off-site sessions.",
  },
  {
    id: "workplaces",
    title: "Workplaces",
    body: "We can discuss possible workplace play days, clinics and league programs based on space and staffing.",
    points: ["Half-day and full-day events", "Workplace leagues", "Beginner-friendly by design"],
  },
  {
    id: "sponsors",
    title: "Sponsors",
    body: "Discuss sponsorship opportunities for future community sport programs. Echelon is not a registered charity and cannot issue charitable tax receipts.",
    points: ["Program and event naming", "Recognition on site and at events", "Updates on programs as reporting develops"],
    verify: "Promise an impact summary only once you'll publish one with verified numbers.",
  },
];
---
<Layout title="Partner with us" description="Schools, municipalities, seniors' residences, workplaces and sponsors: work with Echelon to bring sport and recreation to your community.">
  <section class="page-head">
    <div class="wrap">
      <h1 class="display">Partner with us.</h1>
      <p class="lede">More people playing, closer to home. If you have the space, the people or the support, we'll bring the program.</p>
    </div>
  </section>

  <section class="wrap">
    <div class="trust partner-grid">
      {audiences.map((a) => (
        <div id={a.id} data-verify={a.verify}>
          <h2 class="h3">{a.title}</h2>
          <p>{a.body}</p>
          <ul class="ticks">
            {a.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="kicker">Start a conversation</p>
        <h2 class="h2">Tell us what you have in mind.</h2>
        <p class="lede mt">A few lines is plenty. We'll reply by email, usually within a few business days, to set up a call.</p>
      </div>
      <div class="panel">
        <InquiryForm kind="partner" id="partner" />
      </div>
    </div>
  </section>
</Layout>
